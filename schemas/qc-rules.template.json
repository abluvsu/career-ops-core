{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QC_Rules",
  "type": "object",
  "properties": {
    "bannedTools": { "type": "array", "items": { "type": "string" } },
    "requiredMetrics": { "type": "array", "items": { "type": "string" } },
    "requiredDisclosures": {
      "type": "object",
      "properties": {
        "partTimeLabel": { "type": "boolean" },
        "independentLabel": { "type": "boolean" }
      }
    },
    "portfolioUrlRequired": { "type": "boolean" },
    "minPrimaryBullets": { "type": "number" },
    "minPillars": { "type": "number" },
    "minContentChars": { "type": "number" },
    "minBoldMarkers": { "type": "number" }
  }
}
